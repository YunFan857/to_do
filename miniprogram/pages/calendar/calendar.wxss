.page {
  padding: 20rpx 20rpx 160rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.tool-btn {
  background: #FFFFFF;
  border: 1rpx solid #EAE2CD;
  border-radius: 12rpx;
  padding: 8rpx 22rpx;
  font-size: 26rpx;
  color: #3D3A34;
}

.tool-nav {
  padding: 8rpx 18rpx;
  font-size: 30rpx;
  color: #716C5A;
}

.range-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D3A34;
  margin-left: 8rpx;
}

.calendar {
  background: #FFFDF6;
  border: 1rpx solid #EAE2CD;
  border-radius: 24rpx;
  overflow: hidden;
}

.cal-head {
  display: flex;
}

.cal-head-gutter {
  width: 84rpx;
  flex-shrink: 0;
}

.cal-head-cell {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #EAE2CD;
}

.cal-head-cell.today {
  background: #F9E3EB;
}

.dow {
  font-size: 20rpx;
  color: #A59F8C;
}

.cal-head-cell.today .dow {
  color: #D4537E;
  font-weight: 600;
}

.dom {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D3A34;
  line-height: 1.2;
}

.cal-head-cell.today .dom {
  color: #D4537E;
}

.allday-row {
  display: flex;
  background: #FAF5E9;
  border-bottom: 1rpx solid #EAE2CD;
}

.allday-label {
  width: 84rpx;
  flex-shrink: 0;
  font-size: 18rpx;
  color: #A59F8C;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 10rpx;
}

.allday-cell {
  flex: 1;
  border-left: 1rpx solid #EAE2CD;
  padding: 6rpx;
  min-height: 44rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.allday-chip {
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chip-todo {
  background: #F1ECE1;
  color: #716C5A;
}

.cal-scroll {
  max-height: 900rpx;
}

.cal-body {
  display: flex;
}

.gutter {
  width: 84rpx;
  flex-shrink: 0;
}

.hour-label {
  text-align: right;
  padding-right: 12rpx;
  font-size: 18rpx;
  color: #A59F8C;
}

.day-col {
  flex: 1;
  position: relative;
  border-left: 1rpx solid #EAE2CD;
  background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 43px, #F0EADA 43px, #F0EADA 44px);
}

.day-col.today {
  background-color: rgba(212, 83, 126, 0.035);
}

.cal-evt {
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  border-radius: 10rpx;
  border-left: 6rpx solid;
  padding: 6rpx 12rpx;
  font-size: 20rpx;
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.now-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 3rpx;
  background: #D64545;
  z-index: 3;
}

.now-dot {
  position: absolute;
  left: -6rpx;
  top: -6rpx;
  width: 14rpx;
  height: 14rpx;
  background: #D64545;
  border-radius: 50%;
}

.login-tip {
  text-align: center;
  padding: 60rpx 40rpx;
}

.login-tip-text {
  color: #6B675E;
  margin-bottom: 30rpx;
}

.login-btn {
  display: block;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #D4537E;
  color: #FFFFFF;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(212, 83, 126, 0.35);
}
