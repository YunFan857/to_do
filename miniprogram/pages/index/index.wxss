.page {
  padding: 30rpx 30rpx 160rpx;
}

.rbanner {
  display: flex;
  align-items: center;
  background: #FFF7E0;
  border: 1rpx solid #F0DFA8;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 24rpx;
}

.rbanner-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.rbanner-body {
  flex: 1;
  min-width: 0;
}

.rbanner-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D3A34;
}

.rbanner-sub {
  font-size: 24rpx;
  color: #93590A;
  margin-top: 4rpx;
}

.rbanner-close {
  color: #B8B4A9;
  font-size: 28rpx;
  padding: 10rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D3A34;
  margin-bottom: 18rpx;
}

.section-more {
  font-size: 24rpx;
  color: #D4537E;
  margin-top: 16rpx;
  text-align: right;
}

.event-line {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.event-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.event-time {
  font-size: 26rpx;
  color: #9B988F;
  font-variant-numeric: tabular-nums;
  margin-right: 20rpx;
  width: 96rpx;
}

.event-name {
  font-size: 28rpx;
  color: #3D3A34;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memo-line {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.memo-name {
  font-size: 28rpx;
  color: #3D3A34;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 20rpx;
}

.memo-date {
  font-size: 24rpx;
  color: #9B988F;
  flex-shrink: 0;
}

.memo-overdue {
  color: #C0392B;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-cell {
  width: 20%;
  text-align: center;
  padding: 10rpx 0;
}

.stat-icon {
  font-size: 36rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #9B988F;
  margin-top: 4rpx;
}

.stat-num {
  font-size: 24rpx;
  color: #3D3A34;
  font-weight: 600;
  margin-top: 2rpx;
}

.header {
  padding: 20rpx 8rpx 30rpx;
}

.header-date {
  font-size: 26rpx;
  color: #9B988F;
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #3D3A34;
  margin-top: 8rpx;
}

.progress-card {
  margin-bottom: 30rpx;
}

.progress-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-label {
  font-size: 28rpx;
  color: #6B675E;
}

.progress-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #D4537E;
}

.progress-bar {
  height: 16rpx;
  background: #F1ECE1;
  border-radius: 8rpx;
  margin-top: 18rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #D4537E;
  border-radius: 8rpx;
  transition: width 0.3s;
}

.progress-percent {
  font-size: 24rpx;
  color: #B8B4A9;
  margin-top: 10rpx;
  text-align: right;
}

.login-tip {
  text-align: center;
  padding: 60rpx 40rpx;
}

.login-tip-text {
  color: #6B675E;
  margin-bottom: 30rpx;
}

.login-btn {
  display: block;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #D4537E;
  color: #FFFFFF;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(212, 83, 126, 0.35);
}
