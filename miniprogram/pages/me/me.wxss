.page {
  padding: 30rpx;
}

.login-card {
  text-align: center;
  padding: 80rpx 50rpx;
  margin-top: 80rpx;
}

.login-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #3D3A34;
  margin-bottom: 14rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #9B988F;
  margin-bottom: 50rpx;
}

.login-btn {
  display: block;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #F9E3EB;
  color: #D4537E;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 26rpx;
  flex-shrink: 0;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D3A34;
}

.profile-sub {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.action-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
}

.action-label {
  font-size: 30rpx;
  color: #3D3A34;
}

.action-arrow {
  color: #B8B4A9;
  font-size: 34rpx;
}
